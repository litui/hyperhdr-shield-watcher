SHIELD_IP_ADDRESS=YOUR_SHIELD_IP_HERE
SHIELD_ADB_PORT=5555
HYPERHDR_IP_ADDRESS=127.0.0.1
HYPERHDR_PORT=8090
# Comma-separated list of apps to stop on the shield when a power on state is detected.
# - don't pile on too many here as this is a serial, blocking operation
POWER_ON_STOP_APPS=com.google.android.youtube,com.teamsmart.videomanager.tv
ALWAYS_STOP_APPS=com.netflix.ninja